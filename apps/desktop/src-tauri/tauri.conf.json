{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lucerna",
  "version": "../package.json",
  "identifier": "dev.w3nash.lucerna",
  "build": {
    "beforeDevCommand": "bun run dev:frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lucerna",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExM0IxREQ2RTVCNDE0RDYKUldUV0ZMVGwxaDA3RWJLNDlMVGRLUDVGWkM4Nld2VkxjaWxtVTBXSDJObUVzdDdLNDJjeDh6M08K",
      "endpoints": [
        "https://github.com/w3nash/lucerna/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
